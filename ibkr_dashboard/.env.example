# Copy to .env and fill in. Never commit the real .env -- it holds a token that
# can read your account statements.

# Which data source feeds the dashboard: demo | flex | cpapi
IBKR_PROVIDER=demo

# --- Option A: Flex Web Service (read-only, no software to run) -------------
# Client Portal > Performance & Reports > Flex Queries (create an Activity query,
# XML format), then Settings > Flex Web Service to generate the token.
IBKR_FLEX_TOKEN=
# One or more Flex query IDs, comma separated.
IBKR_FLEX_QUERY_IDS=
# Statements generate asynchronously; raise these if a big query times out.
IBKR_FLEX_POLL_ATTEMPTS=12
IBKR_FLEX_POLL_SECONDS=5

# --- Option B: Client Portal Web API (live, needs the local gateway) --------
IBKR_CPAPI_BASE_URL=https://localhost:5000/v1/api
# The gateway uses a self-signed certificate. This only applies to loopback
# addresses; a remote host is always verified regardless of this setting.
IBKR_CPAPI_VERIFY_SSL=false
# Leave blank to use the first account the gateway returns.
IBKR_CPAPI_ACCOUNT_ID=
IBKR_CPAPI_TIMEOUT_SECONDS=30

# --- Server -----------------------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=8787
IBKR_BASE_CURRENCY=USD
IBKR_DB_PATH=data/ibkr.sqlite3
